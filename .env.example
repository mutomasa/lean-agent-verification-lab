# vLLM (OpenAI 互換 API)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local
VLLM_MODEL=Qwen/Qwen3-1.7B
VLLM_TIMEOUT_SEC=30
AGENT_MAX_RETRIES=2
# json: JSON 出力をスキーマ検証 / tools: vLLM の Tool Calling（--enable-auto-tool-choice --tool-call-parser hermes が必要）
AGENT_TOOL_MODE=json
# 1: vLLM の構造化出力（json_schema）で出力を制約
VLLM_GUIDED_JSON=1

# Lean
LEAN_PROJECT_DIR=lean
LEAN_TIMEOUT_SEC=60
LEAN_WORK_DIR=.lean_work
